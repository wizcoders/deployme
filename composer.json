{
    "name": "wizcoders/deployme",
    "description": "Gitea push-to-deploy webhook endpoint for Laravel, guarded by an Authorization header and an HMAC payload signature.",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Wizcoders"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0",
        "illuminate/process": "^10.17|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Wizcoders\\Deployme\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Wizcoders\\Deployme\\DeploymeServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
